#!/bin/bash

# omarchy:summary=Prune superseded versions from the pacman package cache
# omarchy:requires-sudo=true

set -e

platform_architecture=$(/usr/bin/uname -m 2>/dev/null) || {
  echo "Platform identity is unavailable; refusing direct package-cache updates." >&2
  exit 3
}
case "$platform_architecture" in
  aarch64)
    echo "Apple platform updates require omarchy update platform; refusing direct package-cache updates." >&2
    exit 3
    ;;
  x86_64) ;;
  *)
    echo "Platform identity is not a recognized safe non-Apple architecture; refusing direct package-cache updates." >&2
    exit 3
    ;;
esac

# The cache is the only offline downgrade path, so keep two. Run before the
# packages update and the installed version survives with a spare. paccache
# retains by version order, never by what is installed.
echo -e "\e[32m\nPrune package cache\e[0m"
sudo paccache -rk2 || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
echo
