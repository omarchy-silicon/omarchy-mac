#!/bin/bash

# omarchy:summary=Update system firmware using fwupd. Ensures the fwupd EFI binary is installed
# omarchy:requires-sudo=true

set -e

platform_architecture=$(/usr/bin/uname -m 2>/dev/null) || {
  echo "Platform identity is unavailable; refusing direct firmware updates." >&2
  exit 3
}
case "$platform_architecture" in
  aarch64)
    echo "Apple platform updates require omarchy update platform; refusing direct firmware updates." >&2
    exit 3
    ;;
  x86_64) ;;
  *)
    echo "Platform identity is not a recognized safe non-Apple architecture; refusing direct firmware updates." >&2
    exit 3
    ;;
esac

echo -e "\e[32mUpdate Firmware\e[0m"

if omarchy-cmd-missing fwupdmgr; then
  omarchy-pkg-add fwupd
fi

if [[ -d /sys/firmware/efi ]] && [[ -f /usr/lib/fwupd/efi/fwupdx64.efi ]]; then
  sudo install -D /usr/lib/fwupd/efi/fwupdx64.efi /boot/EFI/arch/fwupdx64.efi
fi

fwupdmgr refresh --force
sudo fwupdmgr update
