#!/bin/bash

# omarchy:summary=Review and optionally remove orphaned system packages after updates
# omarchy:requires-sudo=true

set -e

platform_architecture=$(/usr/bin/uname -m 2>/dev/null) || {
  echo "Platform identity is unavailable; refusing direct orphan package operations." >&2
  exit 3
}
case "$platform_architecture" in
  aarch64)
    echo "Apple platform updates require omarchy update platform; refusing direct orphan package operations." >&2
    exit 3
    ;;
  x86_64) ;;
  *)
    echo "Platform identity is not a recognized safe non-Apple architecture; refusing direct orphan package operations." >&2
    exit 3
    ;;
esac

mapfile -t orphans < <(pacman -Qtdq 2>/dev/null || true)
(( ${#orphans[@]} )) || exit 0

echo -e "\e[32m\nOrphan system packages\e[0m"
printf '  %s\n' "${orphans[@]}"
echo

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "${#orphans[@]} orphaned package(s) found. Re-run omarchy-update-orphan-pkgs in a terminal to review/remove them."
  echo
  exit 0
fi

if ! gum confirm --default=false "Remove ${#orphans[@]} orphaned package(s)?"; then
  echo "Keeping orphaned packages."
  echo
  exit 0
fi

echo -e "\e[32m\nRemoving orphan system packages\e[0m"
sudo pacman -Rns "${orphans[@]}"
echo
